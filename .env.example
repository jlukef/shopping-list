# Copy to .env on the server/local dev machine and fill in real values.
# Do not commit .env.

# FastAPI listens on 127.0.0.1:8770 behind Caddy.
SHOPPING_LIST_HOST=127.0.0.1
SHOPPING_LIST_PORT=8770

# Fresh SQLite application database. Use apps_script only as an explicit fallback.
SHOPPING_LIST_DATA_BACKEND=sqlite
SHOPPING_LIST_DB=data/shopping_list.sqlite

# Existing Apps Script backend, retained only for optional fallback/comparison.
SHOPPING_LIST_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbxIDminbjuYCfrHqNm7vjhLQhDqwyWXrDEK1kUimmlJ9KwmJGHusRYvcU47HuD5kMr0/exec

# Semicolon-separated users:
#   username:pbkdf2_sha256$260000$base64salt$base64hash
# Generate with:
#   python -m src.shopping_list.auth hash-password
SHOPPING_LIST_USERS=

# Session storage. Keep runtime data out of Git.
SHOPPING_LIST_SESSION_DB=data/sessions.sqlite
SHOPPING_LIST_SESSION_DAYS=30

# Set true only when HTTPS is terminating before the app, e.g. production behind Caddy.
SHOPPING_LIST_COOKIE_SECURE=true
